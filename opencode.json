{
  "$schema": "https://opencode.ai/config.json",
  "model": "gateway/free-workhorse",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Gateway (LiteLLM)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "free-workhorse": {
          "name": "Gemini Flash — Free Default"
        },
        "premium": {
          "name": "Gemini Pro — Premium with Fallbacks"
        },
        "bedrock-sonnet": {
          "name": "Claude Sonnet — Bedrock"
        },
        "bedrock-opus": {
          "name": "Claude Opus — Bedrock"
        },
        "free-openai": {
          "name": "OpenAI GPT-4o mini"
        },
        "free-anthropic": {
          "name": "Claude Haiku"
        },
        "free-kimi": {
          "name": "Moonshot Kimi"
        },
        "free-glm": {
          "name": "GLM Flash — Z.ai"
        },
        "free-openrouter": {
          "name": "Nemotron — OpenRouter Free"
        }
      }
    }
  }
}
