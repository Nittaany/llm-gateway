# LiteLLM AI Gateway — environment template
# Copy to .env and fill in your keys, or just run ./setup.sh
#
# After editing, restart: launchctl kickstart -k "gui/$(id -u)/$(cat .launchd-label)"

# Gateway authentication (auto-generated by setup.sh)
LITELLM_MASTER_KEY=replace-with-your-generated-secret

# --- Provider credentials (fill only the ones you use) ---

# Google Gemini (powers: free-workhorse, premium)
GEMINI_API_KEY=

# Amazon Bedrock (powers: bedrock-sonnet, bedrock-opus)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-2

# OpenAI (powers: free-openai)
OPENAI_API_KEY=

# Anthropic (powers: free-anthropic)
ANTHROPIC_API_KEY=

# Moonshot / Kimi (powers: free-kimi)
MOONSHOT_API_KEY=

# Z.ai / GLM (powers: free-glm)
ZAI_API_KEY=

# OpenRouter (powers: free-openrouter)
OPENROUTER_API_KEY=

# --- Optional ---

# PostgreSQL for LiteLLM spend dashboard (requires prisma setup)
# DATABASE_URL=postgresql://localhost:5432/litellm
