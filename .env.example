# LiteLLM gateway authentication
LITELLM_MASTER_KEY=replace-with-your-generated-secret

# Local PostgreSQL connection
DATABASE_URL=postgresql://localhost:5432/litellm

# Provider credentials — populate only the providers you use
GEMINI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# AWS Bedrock region
AWS_REGION=ap-southeast-2
